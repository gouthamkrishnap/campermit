# Turn cameras that are saved to stay off back off after a reboot or replug.
# restore does nothing unless the camera matches a line in /etc/campermit/disabled.
ACTION=="add|bind", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", \
  ATTR{bInterfaceClass}=="0e", ATTR{bInterfaceSubClass}=="01", \
  RUN+="/usr/bin/campermit restore %k"
