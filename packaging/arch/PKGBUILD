pkgname=campermit
pkgver=0.4.0
pkgrel=1
pkgdesc="Enable and disable USB webcams on Linux from the command line"
arch=('any')
url="https://github.com/gouthamkrishnap/campermit"
license=('MIT')
depends=('python')
optdepends=('polkit: ask for a password without sudo')
makedepends=('python-build' 'python-installer' 'python-hatchling')
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('278c02bac77a4c305490f5a4037ea17e9c73b4a578b32fb2e51a55b4a5e7ba64')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 packaging/udev/99-campermit.rules \
    "$pkgdir/usr/lib/udev/rules.d/99-campermit.rules"
  install -Dm644 packaging/polkit/org.campermit.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.campermit.policy"
}